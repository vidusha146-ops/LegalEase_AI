# ==============================================================================
# LegalEase AI - Root Environment Variables Template
# Copy this file to .env and backend/.env and update values accordingly
# ==============================================================================

# Application Environment
ENVIRONMENT=development
APP_NAME="LegalEase AI - Intelligent Legal Decision Support System"
API_V1_STR="/api/v1"

# Backend Server
HOST=127.0.0.1
PORT=8000

# Security & Authentication
# Generate a strong 32-byte secret using: openssl rand -hex 32
SECRET_KEY=change-this-in-production-use-a-secure-random-32-byte-hex-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# PostgreSQL Production URL: postgresql+asyncpg://postgres:password@localhost:5432/legalease_db
# SQLite Development Fallback (auto-created if Postgres is unavailable):
DATABASE_URL=sqlite+aiosqlite:///./backend/legalease.db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Artificial Intelligence (Gemini API)
# Get your key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Vector Database (ChromaDB)
CHROMA_PERSIST_DIRECTORY=./backend/chroma_data

# Uploads & Storage
UPLOAD_DIR=./backend/storage/uploads
MAX_UPLOAD_SIZE_MB=15
