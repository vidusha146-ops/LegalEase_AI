# LegalEase AI - Backend Environment Configuration
ENVIRONMENT=development
APP_NAME="LegalEase AI - Intelligent Legal Decision Support System"
API_V1_STR=/api/v1
HOST=127.0.0.1
PORT=8000

# Security (Change in production!)
SECRET_KEY=change-this-in-production-use-a-secure-random-32-byte-hex-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite development fallback; replace with postgresql+asyncpg://... for PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./legalease.db

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Gemini API Key (Required for Phase 2+)
GEMINI_API_KEY=

# ChromaDB & Storage Paths
CHROMA_PERSIST_DIRECTORY=./chroma_data
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=15
